# ─── Auth (SHA-256 HMAC — no native deps, works on Cloudflare Edge) ───────────
#
# Generate your password hash with ONE of these commands:
#
# Node.js:
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex'),h=c.createHmac('sha256',s).update('YourPassword').digest('hex');console.log('ADMIN_PASSWORD_HASH='+s+':'+h)"
#
# The output looks like: ADMIN_PASSWORD_HASH=a1b2c3...:d4e5f6...
# Paste the FULL value (including the colon and both parts) below.
#
ADMIN_PASSWORD_HASH="paste-your-salt:hash-here"

# JWT secret — any random 32+ char string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="paste-your-64-char-hex-here"

# Session duration in seconds (14400 = 4 hours)
SESSION_MAX_AGE=14400

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-project.pages.dev

# ─── Image Upload (optional) ──────────────────────────────────────────────────
# Free key from https://api.imgbb.com/
IMGBB_API_KEY=your-imgbb-key-here
