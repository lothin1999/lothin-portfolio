# ─── Auth (Session config — JWT is used for secure Edge cookie auth session) ───
# Generate a random 32+ char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-32-char-hex-secret-here"
SESSION_MAX_AGE=14400

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-project.pages.dev

# ─── Firebase Auth (Google Sign-In) ──────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ─── Admin Config ─────────────────────────────────────────────────────────────
# Comma-separated list of Google Account emails allowed to access the admin dashboard
ADMIN_EMAIL="admin@example.com"


CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
PORTFOLIO_BUCKET=""
